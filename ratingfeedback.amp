%%[
VAR @customerID, @customerRows, @rowCount, @i, @row
VAR @HighestRating, @HighestRatingComment, @LowestRating
VAR @AverageRating, @TotalSubmissions, @RecentFeedbackDate

/* Default row count */
SET @rowCount = 0
SET @toDisplay = "True"

/* Only run lookup if CustomerID exists */
SET @customerRows = LookupRows("Customer_Feedback_Aggregate_View", "ToDisplay", @toDisplay)

/*Get the rowcount of the customerRows*/
SET @rowCount = RowCount(@customerRows)

]%%




  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Feedback Report</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f5f7fa;
      margin: 0;
      padding: 40px 20px;
      color: #333;
    }

    .container {
      max-width: 1300px;
      margin: 0 auto;
    }

    .page-title {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #1f2937;
    }

    .page-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 24px;
    }

    .table-wrapper {
      background: #ffffff;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1100px;
    }

    thead {
      background-color: #2c3e50;
      color: #ffffff;
    }

    th {
      padding: 14px 16px;
      text-align: left;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
    }

    td {
      padding: 14px 16px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 14px;
      vertical-align: top;
    }

    tbody tr:nth-child(even) {
      background-color: #fafbfc;
    }

    tbody tr:hover {
      background-color: #f3f6fa;
    }

    .comment-cell {
      max-width: 360px;
      word-break: break-word;
      line-height: 1.5;
    }

    .rating-high {
      color: #1f9d55;
      font-weight: 700;
    }

    .rating-low {
      color: #d64545;
      font-weight: 700;
    }

    .customer-id {
      font-weight: 600;
      color: #111827;
    }

    .empty-state {
      background: #ffffff;
      border-radius: 10px;
      padding: 32px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
      color: #6b7280;
      font-size: 15px;
    }
  </style>


  <div class="container">
    <div class="page-title">Customer Feedback Report</div>
    <div class="page-subtitle">Summary of customer ratings and latest feedback</div>

    %%[ IF @rowCount > 0 THEN ]%%
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Customer ID</th>
              <th>Highest Rating</th>
              <th>Highest Rating Comment</th>
              <th>Lowest Rating</th>
              <th>Average Rating</th>
              <th>Total Submissions</th>
              <th>Recent Feedback Date</th>
            </tr>
          </thead>
          
            %%[
              FOR @i = 1 TO @rowCount DO
                SET @row = Row(@customerRows, @i)
                SET @customerID = Field(@row, "CustomerID")
                SET @HighestRating = Field(@row, "HighestRating")
                SET @HighestRatingComment = Field(@row, "HighestRatingComment")
                SET @LowestRating = Field(@row, "LowestRating")
                SET @AverageRating = Field(@row, "AverageRating")
                SET @TotalSubmissions = Field(@row, "TotalSubmissions")
                SET @RecentFeedbackDate = Field(@row, "RecentFeedbackDate")
            ]%%
            <tr>
              <td class="customer-id">%%=v(@customerID)=%%</td>
              <td class="rating-high">%%=v(@HighestRating)=%%</td>
              <td class="comment-cell">%%=v(@HighestRatingComment)=%%</td>
              <td class="rating-low">%%=v(@LowestRating)=%%</td>
              <td>%%=v(@AverageRating)=%%</td>
              <td>%%=v(@TotalSubmissions)=%%</td>
              <td>%%=v(@RecentFeedbackDate)=%%</td>
            </tr>
            %%[ NEXT @i ]%%
          
        </table>
      </div>
    %%[ ELSEIF EMPTY(@customerID) THEN ]%%
      <div class="empty-state">
        No CustomerID was passed in the URL.
      </div>
    %%[ ELSE ]%%
      <div class="empty-state">
        No records found in the report.
      </div>
    %%[ ENDIF ]%%
  </div>

